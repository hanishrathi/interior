  "recommendations": [
    {
      "id": "rec-level-access",
      "text": "Form a level-access shower with a linear drain along Wall C and a fixed toughened-glass screen.",
      "rationale": "Removes the step into the shower and keeps water within the wet zone.",
      "certainty": "requires-verification",
      "owner": "Arjun Nair"
    },
    {
      "id": "rec-door-outward",
      "text": "Widen the door to a 900 mm clear opening and hang it to open outward.",
      "rationale": "An outward-opening door cannot be blocked by someone who has fallen inside, and the wider opening suits a walking aid.",
      "certainty": "requires-approval",
      "owner": "Ananya and Rohan Mehta"
    },
    {
      "id": "rec-night-light",
      "text": "Add a warm, low-level night light on a motion sensor near the door.",
      "rationale": "Allows safe movement at night without glare.",
      "certainty": "requires-approval",
      "owner": "Ananya and Rohan Mehta"
    },
    {
      "id": "rec-waterproofing",
      "text": "Remove the existing finishes and re-waterproof the floor and the wet-zone walls.",
      "rationale": "Damp staining on Wall B indicates failure; partial repairs rarely last.",
      "certainty": "requires-verification",
      "owner": "Arjun Nair"
