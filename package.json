{
  "name": "@clawed/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Clawed Design \u2014 design tokens, components, schemas and tooling for a premium interior-design operating system.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:css": "tsx scripts/generate-token-css.ts",
    "tokens:check": "tsx scripts/generate-token-css.ts --check",
    "validate:design-system": "tsx scripts/validate-design-system.ts",
    "validate:products": "tsx scripts/validate-product-data.ts",
    "validate": "npm run validate:design-system && npm run validate:products",
    "build": "npm run clean && npm run tokens:css && tsc -p tsconfig.build.json && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
